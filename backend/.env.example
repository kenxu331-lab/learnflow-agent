# Generate a value with:
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
LEARNFLOW_LOCAL_API_TOKEN=replace-with-a-local-random-token
# Existing Obsidian Vault with a .obsidian directory; do not use a private
# Vault for automated tests.
LEARNFLOW_VAULT_PATH=D:\\path\\to\\learnflow-test-vault
LEARNFLOW_LLM_PROVIDER=openai_compatible
LEARNFLOW_LLM_BASE_URL=https://api.deepseek.com
LEARNFLOW_LLM_MODEL=deepseek-flash
LEARNFLOW_LLM_API_KEY=replace-with-your-local-key
LEARNFLOW_LLM_TIMEOUT_SECONDS=60
LEARNFLOW_LLM_MAX_OUTPUT_TOKENS=2048
